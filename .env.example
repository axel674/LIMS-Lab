# Conexion a PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lims_lab?schema=public"

# Puerto del servidor NestJS
PORT=4000

# URL base de la API (se usa en la documentacion y en el seed informativo)
API_BASE_URL="http://localhost:4000/api"

# JWT (TP 12): secreto con el que se firman los tokens del login.
# Poner una cadena larga y aleatoria, por ejemplo la que da:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca subir el valor real al repo.
JWT_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"
# Cuanto dura el token (1h, 30m, 7d...)
JWT_EXPIRES_IN="1h"
